{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "semi": ["error", "always"],
    "quotes": ["error", "double"]
  },
  "globals": {
    "cordova": "readonly",
    "device": "readonly",
    "StatusBar": "readonly",
    "Fingerprint": "readonly",
    "Chart": "readonly",
    "jsPDF": "readonly"
  }
}