<?xml version='1.0' encoding='utf-8'?>
<widget id="com.stla.shifthub" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Shift Hub</name>
    <description>Master Shift Hub and Payroll Tracker</description>
    <author>King Drew</author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="#ff121212" />
    <preference name="DisallowOverscroll" value="true" />

    <hook type="after_prepare" src="scripts/copy_night_splash.js" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />

        <!-- Splash screens — day mode (Cordova handles these via <splash> tags) -->
        <splash src="res/screen/android/splash-port-mdpi.png"    density="port-mdpi" />
        <splash src="res/screen/android/splash-port-hdpi.png"    density="port-hdpi" />
        <splash src="res/screen/android/splash-port-xhdpi.png"   density="port-xhdpi" />
        <splash src="res/screen/android/splash-port-xxhdpi.png"  density="port-xxhdpi" />
        <splash src="res/screen/android/splash-port-xxxhdpi.png" density="port-xxxhdpi" />
        <splash src="res/screen/android/splash-land-mdpi.png"    density="land-mdpi" />
        <splash src="res/screen/android/splash-land-hdpi.png"    density="land-hdpi" />
        <splash src="res/screen/android/splash-land-xhdpi.png"   density="land-xhdpi" />
        <splash src="res/screen/android/splash-land-xxhdpi.png"  density="land-xxhdpi" />
        <splash src="res/screen/android/splash-land-xxxhdpi.png" density="land-xxxhdpi" />
        <splash src="res/screen/android/splash-sw600dp.png"      density="port-hdpi" />
        <splash src="res/screen/android/splash-sw720dp.png"      density="port-xhdpi" />
        <!-- Night mode splash screens copied by scripts/copy_night_splash.js hook -->

        <preference name="SplashScreen"             value="screen" />
        <preference name="SplashScreenDelay"        value="2000" />
        <preference name="AutoHideSplashScreen"     value="true" />
        <preference name="FadeSplashScreen"         value="true" />
        <preference name="FadeSplashScreenDuration" value="400" />
        <preference name="ShowSplashScreenSpinner"  value="false" />

        <!-- Adaptive launcher icons (Android 8.0+ API 26) — separate foreground/background layers -->
        <icon density="mdpi"    foreground="resources/android/icon-foreground/drawable-mdpi-foreground.png"    background="resources/android/icon-background/drawable-mdpi-background.png" />
        <icon density="hdpi"    foreground="resources/android/icon-foreground/drawable-hdpi-foreground.png"    background="resources/android/icon-background/drawable-hdpi-background.png" />
        <icon density="xhdpi"   foreground="resources/android/icon-foreground/drawable-xhdpi-foreground.png"   background="resources/android/icon-background/drawable-xhdpi-background.png" />
        <icon density="xxhdpi"  foreground="resources/android/icon-foreground/drawable-xxhdpi-foreground.png"  background="resources/android/icon-background/drawable-xxhdpi-background.png" />
        <icon density="xxxhdpi" foreground="resources/android/icon-foreground/drawable-xxxhdpi-foreground.png" background="resources/android/icon-background/drawable-xxxhdpi-background.png" />
        <!-- Round adaptive icons (Android 7.1+) -->
        <icon density="mdpi"    foreground="resources/android/icon-foreground/drawable-mdpi-foreground.png"    background="resources/android/icon-background/drawable-mdpi-background.png"    target="round" />
        <icon density="hdpi"    foreground="resources/android/icon-foreground/drawable-hdpi-foreground.png"    background="resources/android/icon-background/drawable-hdpi-background.png"    target="round" />
        <icon density="xhdpi"   foreground="resources/android/icon-foreground/drawable-xhdpi-foreground.png"   background="resources/android/icon-background/drawable-xhdpi-background.png"   target="round" />
        <icon density="xxhdpi"  foreground="resources/android/icon-foreground/drawable-xxhdpi-foreground.png"  background="resources/android/icon-background/drawable-xxhdpi-background.png"  target="round" />
        <icon density="xxxhdpi" foreground="resources/android/icon-foreground/drawable-xxxhdpi-foreground.png" background="resources/android/icon-background/drawable-xxxhdpi-background.png" target="round" />
        <!-- Legacy flat icons (Android < 8.0 fallback) -->
        <icon density="mdpi"    src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi"    src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi"   src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi"  src="resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
    </platform>

    <plugin name="cordova-plugin-splashscreen" spec="^6.0.0" />
    <plugin name="@moodlehq/cordova-plugin-local-notification" />
    
<plugin name="cordova-plugin-x-socialsharing" />
    <plugin name="cordova-plugin-calendar" />
    <plugin name="cordova-plugin-statusbar" />
    
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#121212" />
    <preference name="StatusBarStyle" value="lightcontent" />

</widget>
