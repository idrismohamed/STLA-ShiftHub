<?xml version='1.0' encoding='utf-8'?>
<widget id="com.stla.shifthub" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>STLA Shift Hub</name>
    <description>Master Shift Hub and Payroll Tracker</description>
    <author>King Drew</author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="ff121212" />
    <preference name="DisallowOverscroll" value="true" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />

        <preference name="SplashScreenDelay" value="2000" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splashTemplate.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#181A1C" />

        <!-- Square launcher icons -->
        <icon density="mdpi"    src="resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi"    src="resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi"   src="resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi"  src="resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="resources/android/icon/drawable-xxxhdpi-icon.png" />
        <!-- Round launcher icons (Android 7.1+) -->
        <icon density="mdpi"    src="resources/android/icon-round/drawable-mdpi-icon.png"    target="round" />
        <icon density="hdpi"    src="resources/android/icon-round/drawable-hdpi-icon.png"    target="round" />
        <icon density="xhdpi"   src="resources/android/icon-round/drawable-xhdpi-icon.png"   target="round" />
        <icon density="xxhdpi"  src="resources/android/icon-round/drawable-xxhdpi-icon.png"  target="round" />
        <icon density="xxxhdpi" src="resources/android/icon-round/drawable-xxxhdpi-icon.png" target="round" />
    </platform>

    <plugin name="@moodlehq/cordova-plugin-local-notification" />
    
<plugin name="cordova-plugin-x-socialsharing" />
    <plugin name="cordova-plugin-calendar" />
    <plugin name="cordova-plugin-statusbar" />
    
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#121212" />
    <preference name="StatusBarStyle" value="lightcontent" />

</widget>
